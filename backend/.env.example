# =============================================================================
# Rutas de servicios — red Docker: virtual_closet (docker-compose.yml)
# =============================================================================
# | Servicio      | Hostname (red)  | Puerto interno | Puerto en host |
# |---------------|-----------------|----------------|----------------|
# | postgres      | postgres        | 5432           | 5432           |
# | minio         | minio           | 9000 / 9001    | 9000 / 9001    |
# | rabbitmq      | rabbitmq        | 5672 / 15672   | 5672 / 15672   |
# | fastapi       | fastapi         | 8000           | 8000           |
# | frontend      | frontend        | 3000           | 3000           |
# | catvton       | catvton         | 8000           | 8001           |
# | fashn         | fashn           | 8000           | 8002           |
# | tryoff-model  | tryoff-model    | 8000           | 8003           |
#
# Modo HOST — backend/Celery fuera de Docker (make dev-backend, pytest):
#   Usar localhost + columna «Puerto en host» en las variables de abajo.
#
# Modo DOCKER — fastapi / celery_worker en compose:
#   docker-compose.yml sobrescribe DATABASE_URL, MINIO_*, RABBITMQ_* y URLs de
#   modelos con los hostnames de la red. No hace falta editar este archivo.
# =============================================================================

# Base de datos
# Docker: postgresql+asyncpg://postgres:postgres@postgres:5432/virtual_closet_dev
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/virtual_closet_dev

# JWT
JWT_SECRET_KEY=change-me-to-a-random-secret-key
JWT_ALGORITHM=HS256
JWT_EXPIRE_DAYS=7

# Email (Resend) — https://resend.com/api-keys
EMAIL_BACKEND=resend
RESEND_API_KEY=

# URLs (navegador / enlaces en correos; siempre host, no nombres Docker)
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# Cookie security (false for local HTTP dev, true for production)
COOKIE_SECURE=false

# MinIO (S3-compatible object storage)
# Docker API: http://minio:9000 — override en docker-compose (fastapi, celery_worker)
MINIO_ENDPOINT=http://localhost:9000
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_ORIGINALS=originals
MINIO_BUCKET_GENERATED=generated
MINIO_BUCKET_THUMBNAILS=thumbnails
MINIO_BUCKET_MODEL_THUMBNAILS=model-thumbnails

# VTON / IA (Virtual Try-On)
# Providers disponibles:
#   compose          — dev: compositor básico sin GPU (default)
#   replicate        — cloud: IDM-VTON via Replicate
#   catvton_replicate — cloud: CatVTON-Flux via Replicate (mejor calidad)
#   catvton_local    — self-hosted: CatVTON-Flux en GPU propia (~24 GB VRAM)
#   fashn_local      — self-hosted: FASHN VTON v1.5 maskless en GPU propia (~8 GB VRAM, recomendado)
#   lmstudio         — experimental: LM Studio (no recomendado para VTON)
#   local            — self-hosted: IDM-VTON GPU local
VTON_PROVIDER=compose

# Replicate — necesario para: replicate, catvton_replicate
# Token: https://replicate.com/account/api-tokens (formato r8_...)
REPLICATE_API_KEY=

# CatVTON-Flux via Replicate
# Busca el modelo en https://replicate.com y verifica el schema de inputs.
CATVTON_REPLICATE_MODEL=zhengchong/catvton
# CatVTON-Flux self-hosted (docker compose --profile gpu up catvton)
# Docker: http://catvton:8000 — Host: http://localhost:8001
CATVTON_LOCAL_URL=http://localhost:8001
# Tipo de prenda para proveedores cloud/compose (upper | lower | overall).
# Con VTON_PROVIDER=catvton_local el worker llama POST /classify en el contenedor catvton.
CATVTON_CLOTH_TYPE=upper
# HuggingFace token — repos gated (CatVTON FLUX.1-dev, TryOff FLUX.2-klein-base-9B).
# Token Read clásico recomendado. Si es fine-grained: activar "Access public gated repositories".
# https://huggingface.co/settings/tokens — aceptar licencia en cada modelo gated.
HF_TOKEN=

# TryOff GPU (make docker-flux): LoRA fal/virtual-tryoff-lora + base gated FLUX.2-klein-base-9B
# Guía completa: docker/flux/README.md
# Docker: http://tryoff-model:8000 — Host: http://localhost:8003
TRYOFF_MODEL_URL=http://localhost:8003
# TRYOFF_BASE_MODEL=black-forest-labs/FLUX.2-klein-base-9B

# FASHN VTON v1.5 self-hosted (docker compose --profile gpu up fashn)
# Docker: http://fashn:8000 — Host: http://localhost:8002
# Pesos públicos (Apache-2.0), no requiere HF_TOKEN.
FASHN_LOCAL_URL=http://localhost:8002
# Tipo de imagen de prenda: flat-lay (foto de producto/percha) | model (puesta en modelo)
FASHN_GARMENT_PHOTO_TYPE=flat-lay
# Post-proceso en el servidor FASHN para quitar artefactos en piernas (vestidos/rompers)
FASHN_LEG_POSTPROCESS=true
# Restaurar manos/brazos desde la foto original (evita dedos borrosos en el vestido)
FASHN_PRESERVE_LIMBS=true

# LM Studio — native REST API POST /api/v1/chat (solo en host, no en compose)
LMSTUDIO_BASE_URL=http://localhost:1234
# Model id as shown in LM Studio (e.g. google/gemma-4-31b)
LMSTUDIO_MODEL=google/gemma-4-31b
LMSTUDIO_API_KEY=lm-studio
# Optional custom system prompt for placement hints
LMSTUDIO_SYSTEM_PROMPT=

# IDM-VTON local (solo si VTON_PROVIDER=local)
# Docker: http://catvton:8000 o servicio idm-vton si se añade — Host: http://localhost:8001
VTON_LOCAL_URL=http://localhost:8001

# RabbitMQ / Celery
# Docker: amqp://guest:guest@rabbitmq:5672/
# Host (solo infra en Docker): docker compose up rabbitmq -d
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# Seed images directory (for local development)
# Docker fastapi: /app/seed-imgs (montaje en compose)
SEED_IMGS_DIR=./docs/imgs

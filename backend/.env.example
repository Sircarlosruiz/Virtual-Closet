# Base de datos
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/virtual_closet_dev

# JWT
JWT_SECRET_KEY=change-me-to-a-random-secret-key
JWT_ALGORITHM=HS256
JWT_EXPIRE_DAYS=7

# Email (Resend) — https://resend.com/api-keys
# EMAIL_BACKEND=resend  → envía correos reales (requiere API key)
# EMAIL_BACKEND=console → solo imprime enlaces en logs del backend (sin Resend)
EMAIL_BACKEND=resend
RESEND_API_KEY=
#
# IMPORTANTE (cuenta Resend sin dominio verificado):
# Con remitente onboarding@resend.dev solo puedes enviar al email de tu cuenta Resend.
# Para enviar a otros clientes: verifica un dominio en resend.com/domains y usa
# RESEND_FROM_EMAIL=noreply@tudominio.com

# URLs
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# Cookie security (false for local HTTP dev, true for production)
COOKIE_SECURE=false

# MinIO (S3-compatible object storage)
# Local API (make dev-backend) + Celery in Docker: keep localhost:9000 here; celery_worker uses
# host.docker.internal:9000 in docker-compose so both hit the same store (WSL can expose a
# different MinIO on localhost than the minio container on the Docker network).
MINIO_ENDPOINT=http://localhost:9000
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_ORIGINALS=originals
MINIO_BUCKET_GENERATED=generated
MINIO_BUCKET_THUMBNAILS=thumbnails
MINIO_BUCKET_MODEL_THUMBNAILS=model-thumbnails

# VTON / IA (Virtual Try-On)
# Providers disponibles:
#   compose          — dev: compositor básico sin GPU (default)
#   replicate        — cloud: IDM-VTON via Replicate
#   catvton_replicate — cloud: CatVTON-Flux via Replicate (mejor calidad)
#   catvton_local    — self-hosted: CatVTON-Flux en GPU propia
#   lmstudio         — experimental: LM Studio (no recomendado para VTON)
#   local            — self-hosted: IDM-VTON GPU local
VTON_PROVIDER=compose

# Replicate — necesario para: replicate, catvton_replicate
# Token: https://replicate.com/account/api-tokens (formato r8_...)
REPLICATE_API_KEY=

# CatVTON-Flux via Replicate
# Busca el modelo en https://replicate.com y verifica el schema de inputs.
CATVTON_REPLICATE_MODEL=zhengchong/catvton
# CatVTON-Flux self-hosted (docker compose --profile gpu up catvton)
CATVTON_LOCAL_URL=http://localhost:8001
# Tipo de prenda para proveedores cloud/compose (upper | lower | overall).
# Con VTON_PROVIDER=catvton_local el worker llama POST /classify en el contenedor catvton.
CATVTON_CLOTH_TYPE=upper
# HuggingFace token — requerido para descargar FLUX.1-Fill-dev (modelo gated)
HF_TOKEN=

# LM Studio — native REST API POST /api/v1/chat
LMSTUDIO_BASE_URL=http://localhost:1234
# Model id as shown in LM Studio (e.g. google/gemma-4-31b)
LMSTUDIO_MODEL=google/gemma-4-31b
LMSTUDIO_API_KEY=lm-studio
# Optional custom system prompt for placement hints
LMSTUDIO_SYSTEM_PROMPT=

# IDM-VTON local (solo si VTON_PROVIDER=local)
VTON_LOCAL_URL=http://localhost:8001

# RabbitMQ / Celery (backend local + RabbitMQ en Docker: docker compose up rabbitmq -d)
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# Seed images directory (for local development)
SEED_IMGS_DIR=./docs/imgs

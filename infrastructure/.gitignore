# Terraform state — always remote (S3 backend)
*.tfstate
*.tfstate.backup
*.tfstate.lock.info

# Local variable files with secrets
terraform.tfvars
*.auto.tfvars

# Terraform working directory
.terraform/
.terraform.lock.hcl

# Crash log files
crash.log
crash.*.log

# Override files (local dev only)
override.tf
override.tf.json
*_override.tf
*_override.tf.json

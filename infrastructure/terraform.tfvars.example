# =============================================================================
# Terraform Variables — Example
# Copy to terraform.tfvars (gitignored) and fill in real values.
# Sensitive values should be set as environment variables (TF_VAR_*) or
# stored in the S3 backend / CI secrets, not in this file.
# =============================================================================

aws_region             = "us-west-2"
cluster_name           = "virtualcloset-staging"
environment            = "staging"
eks_kubernetes_version = "1.30"

# Node sizing — t3.large = 2 vCPU / 8 GB RAM
node_instance_type = "t3.large"
node_desired_size  = 2
node_min_size      = 1
node_max_size      = 3

# CIDR blocks for SSH access — use static IPs
# admin_cidrs = ["YOUR.IP.ADDRESS/32"]

# SSH public key path for node access
ssh_public_key_path = "~/.ssh/id_rsa.pub"

# PostgreSQL password — used to create the backup k8s Secret
# postgres_password = "..."  # Set as TF_VAR_postgres_password env var

# Rollback one migration revision.
#
# Usage:
#   sed "s/IMAGE_TAG/${GIT_SHA}/g" rollback-job.yaml.template | kubectl create -f -
#
# IMAGE_TAG must be the tag of the image that APPLIED the migration being undone
# (the new image, not the old one). The new image contains the downgrade() function
# for the revision being reversed.
#
# Rollback procedure:
#   1. Scale backend to 0 replicas:
#        kubectl scale deployment/backend --replicas=0 -n virtual-closet-staging
#   2. Apply this rollback Job:
#        sed "s/IMAGE_TAG/${GIT_SHA}/g" rollback-job.yaml.template | kubectl create -f -
#   3. Wait for completion:
#        kubectl wait --for=condition=complete job/alembic-rollback-${GIT_SHA} \
#          -n virtual-closet-staging --timeout=120s
#   4. Re-deploy the previous image tag:
#        sed "s/IMAGE_TAG/${PREVIOUS_SHA}/g" k8s/staging/backend/deployment.yaml | kubectl apply -f -
#   5. Scale backend back up:
#        kubectl scale deployment/backend --replicas=2 -n virtual-closet-staging
apiVersion: batch/v1
kind: Job
metadata:
  name: alembic-rollback-IMAGE_TAG
  namespace: virtual-closet-staging
  labels:
    app.kubernetes.io/name: alembic-rollback
    app.kubernetes.io/component: migration
    app.kubernetes.io/version: "IMAGE_TAG"
spec:
  backoffLimit: 0
  activeDeadlineSeconds: 120
  ttlSecondsAfterFinished: 3600
  template:
    metadata:
      labels:
        app.kubernetes.io/name: alembic-rollback
        app.kubernetes.io/component: migration
    spec:
      restartPolicy: Never
      serviceAccountName: backend
      containers:
        - name: rollback
          image: virtual-closet/backend:IMAGE_TAG
          command: ["alembic", "downgrade", "-1"]
          envFrom:
            - configMapRef:
                name: virtual-closet-config
            - secretRef:
                name: virtual-closet-secrets
          resources:
            requests:
              cpu: 100m
              memory: 256Mi
            limits:
              cpu: 200m
              memory: 512Mi
